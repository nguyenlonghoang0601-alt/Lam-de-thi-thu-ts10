<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thi thử trải nghiệm - Tuyển sinh 10</title><style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;color:#26364a;background:#f7f7f7;background-image:radial-gradient(#ddd 1px,transparent 1px);background-size:8px 8px}button,input{font:inherit}.top{height:118px;background:linear-gradient(110deg,#075fc5,#008ee8);color:#fff;display:flex;align-items:center;padding:0 9%;gap:28px;box-shadow:0 2px 8px #999}.top h1{font-size:48px;margin:0;font-weight:900}.gov{margin-left:auto;display:flex;align-items:center;gap:12px;font-weight:800;font-size:18px}.seal{width:58px;height:58px;border-radius:50%;background:#f6c400;color:#d71920;display:grid;place-items:center;font-size:30px;border:3px solid #ffd84a}.title{text-align:center;font-size:28px;font-weight:800;margin:26px 0;color:#222}.panel{max-width:1200px;margin:0 auto 60px;background:#eaf3ff;padding:24px 36px 60px;min-height:600px}.panel>h2{text-align:center;color:#244987;font-size:24px;margin:14px 0 26px}.cards{display:grid;grid-template-columns:1fr 1fr;gap:16px}.card{background:#fff;border-radius:10px;padding:18px;box-shadow:0 2px 10px #d5dde8}.card h3{margin:0 0 14px;color:#244987;font-size:16px}.row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field label{display:block;font-size:13px;margin-bottom:6px;color:#4c5562}.field input,.field select{width:100%;padding:11px 12px;border:1px solid #cbd6e4;border-radius:7px;background:#fff;outline:none}.field input:focus,.field select:focus{border-color:#2464c6;box-shadow:0 0 0 3px #dbeaff}.subjectbox{margin-top:16px;background:#fff;border-radius:10px;padding:14px 16px;box-shadow:0 2px 10px #d5dde8}.subjectgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.subject{display:flex;align-items:center;justify-content:space-between;padding:12px 10px;background:#fafafa;border:1px solid #e7ebf1;border-radius:5px;font-size:13px;font-weight:700}.btn{border:0;border-radius:6px;padding:10px 18px;background:#1745a3;color:white;font-weight:800;cursor:pointer}.btn.light{background:#fff;color:#1745a3;border:1px solid #9fb1cc}.btn.green{background:#0d7a53}.center{text-align:center;margin-top:26px}.notice{background:#fff8d9;border:1px dashed #d4b53b;padding:12px 14px;border-radius:8px;line-height:1.5;margin-top:14px}.hidden{display:none!important}.dashboard{max-width:1200px;margin:0 auto;padding:0 18px 60px}.dashhead{display:flex;justify-content:space-between;align-items:center;margin:22px 0}.dashhead h2{margin:0;color:#244987}.userpill{background:#fff;border:1px solid #d6e0ec;padding:10px 14px;border-radius:8px}.subjectcards{display:grid;grid-template-columns:1fr 1fr;gap:18px}.subjectcard{background:#fff;border-radius:12px;padding:24px;box-shadow:0 2px 12px #dbe2eb;border-top:5px solid #1c5eb9}.subjectcard h3{font-size:28px;margin:0 0 8px;color:#164a9c}.subjectcard p{color:#68778a;line-height:1.5}.meta{display:flex;gap:12px;flex-wrap:wrap;margin:16px 0}.pill{background:#eef4ff;color:#174a9c;padding:7px 10px;border-radius:99px;font-size:13px;font-weight:700}.rankcard{margin-top:18px;background:#fff;border-radius:12px;padding:20px;box-shadow:0 2px 12px #dbe2eb}table{width:100%;border-collapse:collapse}th,td{padding:11px;border-bottom:1px solid #e5ebf3;text-align:left}th{background:#f5f8fc}.exambar{position:sticky;top:0;z-index:5;background:#123d83;color:#fff;padding:12px 18px;display:flex;align-items:center;gap:16px;box-shadow:0 2px 8px #999}.examname{font-weight:800;flex:1}.clock{font-size:22px;font-weight:900;background:#fff;color:#173d82;border-radius:7px;padding:8px 12px;min-width:95px;text-align:center}.clock.warn{background:#ffdddd;color:#a50000}.paper{max-width:1000px;margin:22px auto 60px;background:#fff;border-radius:10px;padding:22px;box-shadow:0 2px 12px #dbe2eb}.q{padding:16px 0;border-bottom:1px solid #e8edf3}.q h3{font-size:16px;line-height:1.5;margin:0 0 10px}.opt{display:block;padding:8px 10px;border-radius:7px;cursor:pointer}.opt:hover{background:#f4f7fb}.writtenbox{background:#f7fbff;border:1px solid #dce8f6;padding:14px;border-radius:10px;margin:10px 0}.answer{width:100%;padding:10px;border:1px solid #cbd8e7;border-radius:8px}.actions{display:flex;justify-content:space-between;gap:10px;margin-top:20px}.result{max-width:800px;margin:40px auto;background:#fff;border-radius:12px;padding:40px;text-align:center;box-shadow:0 2px 12px #dbe2eb}.score{font-size:62px;font-weight:900;color:#1769d2}@media(max-width:800px){.top{padding:0 18px;height:92px}.top h1{font-size:30px}.gov{display:none}.cards,.subjectcards{grid-template-columns:1fr}.subjectgrid{grid-template-columns:1fr 1fr}.panel{margin:0 10px 30px;padding:16px}.row{grid-template-columns:1fr}}@media(max-width:520px){.top h1{font-size:24px}.subjectgrid{grid-template-columns:1fr}.paper{margin:10px;padding:14px}.exambar{flex-wrap:wrap}.examname{min-width:100%}}
</style></head><body>
<header class="top"><h1>GIAO DIỆN THI TRÊN MÁY TÍNH</h1></header>
<div id="login"><div class="title">THI THỬ TRẢI NGHIỆM – LUYỆN ÔN TUYỂN SINH 10</div><section class="panel"><h2>NHẬP THÔNG TIN THÍ SINH</h2><div class="cards"><div class="card"><h3>THÔNG TIN THÍ SINH</h3><div class="row"><div class="field"><label>Họ và tên *</label><input id="name" placeholder="Nguyễn Văn A"></div><div class="field"><label>Số báo danh *</label><input id="sbd" placeholder="VD: 100001"></div><div class="field"><label>Ngày sinh</label><input id="dob" type="date"></div><div class="field"><label>Giới tính</label><select id="gender"><option>Nữ</option><option>Nam</option><option>Khác</option></select></div><div class="field"><label>Trường</label><input id="school" placeholder="Tên trường THCS"></div><div class="field"><label>Lớp</label><input id="className" placeholder="9A1"></div></div></div><div class="card"><h3>THÔNG TIN KỲ THI</h3><div class="row"><div class="field"><label>Đợt thi</label><input value="Thi thử trải nghiệm" disabled></div><div class="field"><label>Mục tiêu</label><input value="Luyện ôn tuyển sinh 10" disabled></div><div class="field"><label>Năm</label><input value="2026" disabled></div><div class="field"><label>Hình thức</label><input value="Thi trực tuyến" disabled></div></div><div class="notice">Đây là website <b>thi thử trải nghiệm và luyện ôn tuyển sinh 10</b>, không phải kỳ thi chính thức. Kết quả dùng để tự đánh giá và xếp hạng luyện tập.</div></div></div><div class="subjectbox"><h3>DANH SÁCH MÔN THI</h3><div class="subjectgrid"><div class="subject">Toán <button class="btn" onclick="loginAndOpen('math')">Vào thi</button></div><div class="subject">Tiếng Anh <button class="btn" onclick="loginAndOpen('english')">Vào thi</button></div><div class="subject">Ngữ văn <span>Đang cập nhật</span></div><div class="subject">Môn tự chọn <span>Đang cập nhật</span></div></div></div><div class="center"><button class="btn green" onclick="enterSystem()">XÁC NHẬN & VÀO HỆ THỐNG</button></div></section></div>
<div id="dashboard" class="hidden"><div class="dashboard"><div class="dashhead"><h2>GIAO DIỆN THÍ SINH SAU KHI ĐĂNG NHẬP</h2><div class="userpill" id="userpill"></div></div><div class="cards"><div class="card"><h3>THÔNG TIN THÍ SINH</h3><div id="info"></div></div><div class="card"><h3>THÔNG TIN KỲ THI</h3><p><b>Loại:</b> Thi thử trải nghiệm</p><p><b>Mục tiêu:</b> Luyện ôn tuyển sinh 10</p><p><b>Hình thức:</b> Trực tuyến</p></div></div><div class="subjectcards" style="margin-top:18px"><div class="subjectcard"><h3>Toán</h3><p>12 đề riêng biệt, từ cơ bản đến phân hóa.</p><div class="meta"><span class="pill">12 đề</span><span class="pill">20 TN + 8 Đ/S + 3 ngắn</span><span class="pill">90 phút</span></div><button class="btn" onclick="openSubject('math')">Vào kho đề Toán →</button></div><div class="subjectcard"><h3>Tiếng Anh</h3><p>12 đề luyện thi, có trắc nghiệm và phần tự luận.</p><div class="meta"><span class="pill">12 đề</span><span class="pill">28 TN + 12 tự luận</span><span class="pill">60 phút</span></div><button class="btn" onclick="openSubject('english')">Vào kho đề Tiếng Anh →</button></div></div><div class="rankcard"><div style="display:flex;justify-content:space-between;align-items:center"><h2>🏆 BẢNG XẾP HẠNG</h2><button class="btn light" onclick="renderRank()">Làm mới</button></div><div id="rankbox"></div></div></div></div>
<div id="library" class="hidden"><div class="dashboard"><div class="dashhead"><h2 id="libraryTitle"></h2><button class="btn light" onclick="showDashboard()">← Trang thí sinh</button></div><div id="examGrid" class="subjectcards"></div></div></div>
<div id="exam" class="hidden"><div class="exambar"><div id="examname" class="examname"></div><div id="clock" class="clock">00:00</div><button class="btn" onclick="submitExam(false)">NỘP BÀI</button></div><div class="paper"><div id="questions"></div><div class="actions"><button class="btn light" onclick="showLibrary()">Thoát</button><button class="btn" onclick="submitExam(false)">Nộp bài & chấm điểm</button></div></div></div>
<div id="result" class="hidden"><div class="result"><h2>KẾT QUẢ THI</h2><div id="score" class="score">0/10</div><div id="summary"></div><br><button class="btn" onclick="showDashboard()">Về trang thí sinh</button></div></div>
<script>
const mathExams=[{"id":1,"title":"Đề 01 • Khởi động đại số","type":"easy","tag":"Cơ bản","desc":"20 trắc nghiệm + 2 Đúng/Sai + 3 trả lời ngắn • 90 phút","questions":[{"q":"Cho hàm số y=-2x². Giá trị của y khi x=-3 là","o":["-18","18","-6","6"],"a":0},{"q":"Phương trình x²-7x+12=0 có nghiệm là","o":["3 và 4","-3 và -4","2 và 6","1 và 12"],"a":0},{"q":"Hệ phương trình x+y=11, 2x-y=4 có nghiệm","o":["(5;6)","(6;5)","(4;7)","(7;4)"],"a":0},{"q":"Rút gọn √50 bằng","o":["5√2","10√2","25√2","√25"],"a":0},{"q":"Đường thẳng y=-3x+5 cắt trục tung tại điểm","o":["(0;5)","(5;0)","(0;-3)","(-3;0)"],"a":0},{"q":"Một tam giác vuông có hai cạnh góc vuông 9 và 12. Cạnh huyền bằng","o":["15","18","21","13"],"a":0},{"q":"Điều kiện xác định của √(2x-6) là","o":["x≥3","x≤3","x>3","x<3"],"a":0},{"q":"Nếu hai nghiệm của x²-5x+6=0 là x1,x2 thì x1+x2 bằng","o":["5","-5","6","-6"],"a":0},{"q":"Diện tích hình tròn bán kính 5 cm, lấy π=3,14 là","o":["78,5","31,4","157","25"],"a":0},{"q":"Tọa độ giao điểm của y=x+2 và y=4 là","o":["(2;4)","(4;2)","(-2;4)","(2;-4)"],"a":0},{"q":"Một số tăng từ 80 lên 100. Tỉ lệ tăng là","o":["25%","20%","30%","12,5%"],"a":0},{"q":"Giá trị của (√3-1)(√3+1) là","o":["2","3","1","4"],"a":0},{"q":"Nếu a,b là hai nghiệm của 2x²-3x-2=0 thì ab bằng","o":["-1","1","-2","2"],"a":0},{"q":"Đường tròn có đường kính 14 cm thì chu vi là","o":["14π cm","7π cm","28π cm","49π cm"],"a":0},{"q":"Parabol y=x² có điểm nào thuộc đồ thị","o":["(-2;4)","(2;2)","(-1;2)","(3;6)"],"a":0},{"q":"Giải bất phương trình 3x-5≤7 được","o":["x≤4","x≥4","x≤2/3","x≥2/3"],"a":0},{"q":"Hai tiếp tuyến từ M đến đường tròn có","o":["độ dài bằng nhau","độ dài luôn khác nhau","tổng bằng bán kính","tích bằng bán kính"],"a":0},{"q":"Một hình chữ nhật có chu vi 30 cm, chiều dài 9 cm. Chiều rộng là","o":["6","5","7","12"],"a":0},{"q":"Nếu tan α=3/4 với α nhọn thì sin α bằng","o":["3/5","4/5","3/4","4/3"],"a":0},{"q":"Phương trình 4x²-9=0 có nghiệm","o":["±3/2","3/2","±9/4","±2/3"],"a":0}],"tf":[{"q":"Cho A=(x−3)².","items":["A=x²−6x+9","A luôn không âm","A(3)=0","A(0)=9"],"a":[1,1,1,1]},{"q":"Trong tam giác vuông ABC tại A.","items":["BC là cạnh huyền","AB²+AC²=BC²","Hai góc B,C phụ nhau","AB=AC luôn đúng"],"a":[1,1,1,0]}],"short":[{"q":"Tính √144−5.","a":"7"},{"q":"Tam giác vuông có hai cạnh 9 và 40. Cạnh huyền?","a":"41"},{"q":"Giải 2x+5=17.","a":"6"}]},{"id":2,"title":"Đề 02 • Nền tảng tổng hợp","type":"easy","tag":"Cơ bản","desc":"20 trắc nghiệm + 2 Đúng/Sai + 3 trả lời ngắn • 90 phút","questions":[{"q":"Hàm số y=1/2 x² nhận giá trị nào khi x=4","o":["8","4","2","16"],"a":0},{"q":"Phương trình 2x²-5x+2=0 có nghiệm","o":["1/2 và 2","-1/2 và -2","1 và 2","-1 và 2"],"a":0},{"q":"Hệ x-y=3, x+y=9 có nghiệm","o":["(6;3)","(3;6)","(5;4)","(4;5)"],"a":0},{"q":"√72 bằng","o":["6√2","12√2","3√8","36√2"],"a":0},{"q":"Đường thẳng đi qua A(1;2), B(3;6) có hệ số góc","o":["2","-2","1/2","4"],"a":0},{"q":"Tam giác vuông có cạnh huyền 13 và một cạnh 5. Cạnh kia","o":["12","10","8","14"],"a":0},{"q":"Điều kiện của √(5-x) là","o":["x≤5","x≥5","x<5","x>5"],"a":0},{"q":"Với x²-8x+15=0, tích hai nghiệm bằng","o":["15","8","-15","-8"],"a":0},{"q":"Diện tích tam giác đáy 12 cm, chiều cao 7 cm là","o":["42","84","19","38"],"a":0},{"q":"Đồ thị y=-x+6 cắt trục hoành tại","o":["(6;0)","(0;6)","(-6;0)","(0;-6)"],"a":0},{"q":"Giá 250000 đồng giảm 12% còn","o":["220000","225000","230000","238000"],"a":0},{"q":"(2+√5)(2-√5) bằng","o":["-1","1","4","-5"],"a":0},{"q":"Hai nghiệm của 3x²+x-2=0 có tổng","o":["-1/3","1/3","-2/3","2/3"],"a":0},{"q":"Bán kính 3 cm, diện tích hình tròn (π=3,14)","o":["28,26","18,84","9,42","56,52"],"a":0},{"q":"Điểm nào thuộc y=2x-1","o":["(2;3)","(1;2)","(0;1)","(-1;0)"],"a":0},{"q":"2x+1>9 tương đương","o":["x>4","x<4","x≥4","x≤4"],"a":0},{"q":"Từ điểm ngoài đường tròn, hai tiếp tuyến có","o":["hai đoạn tiếp tuyến bằng nhau","hai bán kính bằng nhau","cùng đi qua tâm","vuông góc nhau"],"a":0},{"q":"Hình vuông diện tích 81 cm² có cạnh","o":["9","18","27","40,5"],"a":0},{