const englishExams=[{"id":1,"title":"Đề 01 • Daily Life & School","level":"easy","desc":"60 phút • 28 câu trắc nghiệm (7,0 điểm) + 12 câu tự luận (3,0 điểm)","questions":[{"q":"The school library ______ many useful books for students.","o":["provides","providing","provide","provided"],"a":0},{"q":"My sister usually goes to school ______ bicycle.","o":["in","by","on","at"],"a":1},{"q":"When I arrived, they ______ dinner.","o":["have","had","were having","are having"],"a":2},{"q":"This exercise is ______ than the previous one.","o":["easy","easier","easiest","as easy"],"a":1},{"q":"If you study hard, you ______ good results.","o":["get","got","will get","would get"],"a":2},{"q":"The student ______ won the prize is my best friend.","o":["which","whose","who","whom"],"a":2},{"q":"Please ______ the lights before leaving the room.","o":["turn off","turn on","look after","take after"],"a":0},{"q":"We should ______ plastic waste to protect the environment.","o":["increase","reduce","borrow","invite"],"a":1},{"q":"Although it was raining, they ______ playing football.","o":["continued","continue","continues","had continued"],"a":0},{"q":"Mai: “Would you like some orange juice?” Nam: “______”","o":["Yes, please.","Never mind.","That’s all right.","I’m sorry to hear that."],"a":0},{"q":"Lan: “Congratulations on your success!” Hoa: “______”","o":["You’re welcome.","Thanks a lot.","Not at all.","No, thanks."],"a":1},{"q":"NOTICE: KEEP SILENCE IN THE LIBRARY.","o":["You must be quiet in the library.","You may sing in the library.","The library is closed.","Books are not allowed."],"a":0},{"q":"BUS TO SCHOOL: First bus 6:30 a.m. Last bus 7:30 a.m.","o":["The first school bus leaves at 6:30.","The last bus leaves at 6:30.","Buses run all night.","Students must walk."],"a":0},{"q":"a. I joined a reading club last month. b. It has helped me make new friends. c. We meet every Saturday morning.","o":["a-c-b","b-a-c","c-a-b","a-b-c"],"a":0},{"q":"a. We collected old clothes. b. The storm damaged many houses. c. We gave the clothes to families in need.","o":["b-a-c","a-b-c","c-a-b","b-c-a"],"a":0},{"q":"“I will visit the museum tomorrow,” Minh said.","o":["Minh said that he would visit the museum the next day.","Minh said that I would visit the museum tomorrow.","Minh says he visited the museum.","Minh said he will visit the museum yesterday."],"a":0},{"q":"The girl is my cousin. She won the scholarship.","o":["The girl who won the scholarship is my cousin.","The girl which won the scholarship is my cousin.","The girl whom won the scholarship is my cousin.","The girl winning it are my cousin."],"a":0},{"q":"Joining a sports club is a good way (18) _____ healthy.","o":["to stay","staying","stayed","stay"],"a":0},{"q":"Our club meets twice a week, (19) _____ Tuesday and Thursday.","o":["but","and","or","so"],"a":1},{"q":"The activities begin (20) _____ 4 p.m.","o":["in","on","at","for"],"a":2},{"q":"All students (21) _____ welcome to join us.","o":["is","are","was","be"],"a":1},{"q":"Let’s stay (22) _____ and enjoy the activities!","o":["active","actively","activity","act"],"a":0},{"q":"What is the passage mainly about?","o":["A volunteer trip to a village","A school football match","A family holiday","A trip to a big city"],"a":0},{"q":"The word “worried” is closest in meaning to ______.","o":["happy","anxious","bored","excited"],"a":1},{"q":"What did the team do at the school?","o":["Painted the walls","Built a new classroom","Sold books","Taught mathematics"],"a":0},{"q":"Why did the writer become close to the team?","o":["They worked together.","They lived together for years.","They studied at the same school.","They played games all day."],"a":0},{"q":"Which statement is NOT TRUE?","o":["The trip lasted three days.","The children received books.","The writer returned home proud.","The team refused to help the school."],"a":3},{"q":"How did the writer feel at the end?","o":["Tired but proud","Angry and bored","Sad and lonely","Afraid and confused"],"a":0}],"reading":"Last summer, I joined a three-day volunteer trip to a small village. Our team painted the school walls, planted trees and gave books to children. At first, I was worried because I did not know anyone. However, after working together, we became close friends. The children were happy to receive the books and invited us to play football. I returned home tired but proud because I had done something useful.","written":{"word":[{"q":"Linh answered the question ______ and everyone understood her. (CLEAR)","a":"clearly"},{"q":"Tourism contributes to the ______ of many local communities. (DEVELOP)","a":"development"},{"q":"We should protect rivers from ______. (POLLUTE)","a":"pollution"},{"q":"The documentary was very ______, so I watched it twice. (INTEREST)","a":"interesting"}],"rewrite":[{"q":"We stayed at home because it was raining.","a":"Because it was raining, we stayed at home."},{"q":"I do not have enough money, so I cannot buy the laptop.","a":"I wish I had enough money to buy the laptop."},{"q":"Study hard or you will fail the exam.","a":"If you do not study hard, you will fail the exam."},{"q":"“Where do you live?” she asked me.","a":"She asked me where I lived."}],"sentence":[{"q":"Last summer / Mai / visit / her grandparents / in the Mekong Delta","a":"Last summer, Mai visited her grandparents in the Mekong Delta."},{"q":"Doing exercise / be / a good way / stay healthy","a":"Doing exercise is a good way to stay healthy."},{"q":"I / want / join / the English club / because / I love speaking English","a":"I want to join the English club because I love speaking English."},{"q":"The woman / live / next door / often / help / local children","a":"The woman who lives next door often helps local children."}]}},{"id":2,"title":"Đề 02 • Healthy Living","level":"easy","desc":"60 phút • 28 câu trắc nghiệm (7,0 điểm) + 12 câu tự luận (3,0 điểm)","questions":[{"q":"When I arrived, they ______ dinner.","o":["have","had","were having","are having"],"a":2},{"q":"This exercise is ______ than the previous one.","o":["easy","easier","easiest","as easy"],"a":1},{"q":"If you study hard, you ______ good results.","o":["get","got","will get","would get"],"a":2},{"q":"The student ______ won the prize is my best friend.","o":["which","whose","who","whom"],"a":2},{"q":"Please ______ the lights before leaving the room.","o":["turn off","turn on","look after","take after"],"a":0},{"q":"We should ______ plastic waste to protect the environment.","o":["increase","reduce","borrow","invite"],"a":1},{"q":"Although it was raining, they ______ playing football.","o":["continued","continue","continues","had continued"],"a":0},{"q":"She has lived here ______ 2022.","o":["for","since","during","from"],"a":1},{"q":"There isn’t ______ milk in the fridge.","o":["many","a few","much","several"],"a":2},{"q":"Lan: “Congratulations on your success!” Hoa: “______”","o":["You’re welcome.","Thanks a lot.","Not at all.","No, thanks."],"a":1},{"q":"“Why don’t we join the clean-up day?” “______”","o":["Good idea!","I don’t know you.","You’re welcome.","Never mind."],"a":0},{"q":"BUS TO SCHOOL: First bus 6:30 a.m. Last bus 7:30 a.m.","o":["The first school bus leaves at 6:30.","The last bus leaves at 6:30.","Buses run all night.","Students must walk."],"a":0},{"q":"WANTED: VOLUNTEERS TO PLANT TREES. MEET AT 7 A.M. SUNDAY.","o":["Volunteers will plant trees on Sunday morning.","The event is on Saturday night.","Only teachers can join.","Trees are not needed."],"a":0},{"q":"a. We collected old clothes. b. The storm damaged many houses. c. We gave the clothes to families in need.","o":["b-a-c","a-b-c","c-a-b","b-c-a"],"a":0},{"q":"a. I am writing to tell you about my trip. b. We visited several museums. c. It was an unforgettable experience.","o":["a-b-c","b-c-a","c-a-b","a-c-b"],"a":0},{"q":"The girl is my cousin. She won the scholarship.","o":["The girl who won the scholarship is my cousin.","The girl which won the scholarship is my cousin.","The girl whom won the scholarship is my cousin.","The girl winning it are my cousin."],"a":0},{"q":"The weather was bad, but we went hiking.","o":["Although the weather was bad, we went hiking.","Because the weather was bad, we went hiking.","So the weather was bad, we went hiking.","The weather was bad because we went hiking."],"a":0},{"q":"The activities begin (20) _____ 4 p.m.","o":["in","on","at","for"],"a":2},{"q":"All students (21) _____ welcome to join us.","o":["is","are","was","be"],"a":1},{"q":"Let’s stay (22) _____ and enjoy the activities!","o":["active","actively","activity","act"],"a":0},{"q":"Reading every day can help students (18) _____ their vocabulary.","o":["improve","improving","improved","improves"],"a":0},{"q":"We should use public transport (19) _____ reduce air pollution.","o":["so that","because","although","but"],"a":0},{"q":"What is the passage mainly about?","o":["Using smartphones wisely for study","Buying a new smartphone","Playing games online","Avoiding all technology"],"a":0},{"q":"The word “concentrate” is closest in meaning to ______.","o":["focus","sleep","travel","exercise"],"a":0},{"q":"What can teenagers do with smartphones?","o":["Watch lessons","Only make calls","Only play games","Only take photos"],"a":0},{"q":"What may happen if a phone is used too long?","o":["It may reduce exercise time.","It always improves grades.","It makes students stronger.","It replaces sleep with exercise."],"a":0},{"q":"Which is suggested as a solution?","o":["Set a screen-time limit.","Use the phone all day.","Avoid all breaks.","Stop studying online."],"a":0},{"q":"According to the passage, smartphones are ______.","o":["useful when used wisely","always harmful","never useful","only for entertainment"],"a":0}],"reading":"Many teenagers now use smartphones for studying. They can watch lessons, look up new words and join online classes. However, using a phone for too long may make it difficult to concentrate and can reduce time for exercise. A good solution is to set a daily screen-time limit and take regular breaks. Phones are useful learning tools when students use them wisely.","written":{"word":[{"q":"Tourism contributes to the ______ of many local communities. (DEVELOP)","a":"development"},{"q":"We should protect rivers from ______. (POLLUTE)","a":"pollution"},{"q":"The documentary was very ______, so I watched it twice. (INTEREST)","a":"interesting"},{"q":"She sings very ______ in front of the audience. (BEAUTY)","a":"beautifully"}],"rewrite":[{"q":"Study hard or you will fail the exam.","a":"If you do not study hard, you will fail the exam."},{"q":"“Where do you live?” she asked me.","a":"She asked me where I lived."},{"q":"He started working here in 2023.","a":"He has worked here since 2023."},{"q":"Although the test was difficult, Mai finished it.","a":"The test was difficult, but Mai finished it."}],"sentence":[{"q":"I / want / join / the English club / because / I love speaking English","a":"I want to join the English club because I love speaking English."},{"q":"The woman / live / next door / often / help / local children","a":"The woman who lives next door often helps local children."},{"q":"Next month / our class / organize / a clean-up day / at school","a":"Next month, our class will organize a clean-up day at school."},{"q":"My brother / be / interested in / learning / foreign languages","a":"My brother is interested in learning foreign languages."}]}},{"id":3,"title":"Đề 03 • Environment","level":"easy","desc":"60 phút • 28 câu trắc nghiệm (7,0 điểm) + 12 câu tự luận (3,0 điểm)","questions":[{"q":"If you study hard, you ______ good results.","o":["get","got","will get","would get"],"a":2},{"q":"The student ______ won the prize is my best friend.","o":["which","whose","who","whom"],"a":2},{"q":"Please ______ the lights before leaving the room.","o":["turn off","turn on","look after","take after"],"a":0},{"q":"We should ______ plastic waste to protect the environment.","o":["increase","reduce","borrow","invite"],"a":1},{"q":"Although it was raining, they ______ playing football.","o":["continued","continue","continues","had continued"],"a":0},{"q":"She has lived here ______ 2022.","o":["for","since","during","from"],"a":1},{"q":"There isn’t ______ milk in the fridge.","o":["many","a few","much","several"],"a":2},{"q":"My father ______ to work by bus every day.","o":["go","goes","is going","went"],"a":1},{"q":"The movie was ______ that we watched it twice.","o":["so interesting","such interesting","too interest","interestingly"],"a":0},{"q":"“Why don’t we join the clean-up day?” “______”","o":["Good idea!","I don’t know you.","You’re welcome.","Never mind."],"a":0},{"q":"“Could you help me with this exercise?” “______”","o":["Sure. I’d be happy to.","Congratulations!","What a pity!","Good luck."],"a":0},{"q":"WANTED: VOLUNTEERS TO PLANT TREES. MEET AT 7 A.M. SUNDAY.","o":["Volunteers will plant trees on Sunday morning.","The event is on Saturday night.","Only teachers can join.","Trees are not needed."],"a":0},{"q":"SWIMMING POOL: NO FOOD OR DRINKS.","o":["You must not eat or drink there.","You can have lunch there.","Drinks are free.","Food is required."],"a":0},{"q":"a. I am writing to tell you about my trip. b. We visited several museums. c. It was an unforgettable experience.","o":["a-b-c","b-c-a","c-a-b","a-c-b"],"a":0},{"q":"a. First, prepare the ingredients. b. Finally, serve the dish. c. Then, cook them carefully.","o":["a-c-b","b-a-c","c-b-a","a-b-c"],"a":0},{"q":"The weather was bad, but we went hiking.","o":["Although the weather was bad, we went hiking.","Because the weather was bad, we went hiking.","So the weather was bad, we went hiking.","The weather was bad because we went hiking."],"a":0},{"q":"He started learning English three years ago.","o":["He has learned English for three years.","He learns English three years ago.","He learned English since three years.","He has learning English three years."],"a":0},{"q":"Let’s stay (22) _____ and enjoy the activities!","o":["active","actively","activity","act"],"a":0},{"q":"Reading every day can help students (18) _____ their vocabulary.","o":["improve","improving","improved","improves"],"a":0},{"q":"We should use public transport (19) _____ reduce air pollution.","o":["so that","because","although","but"],"a":0},{"q":"The meeting starts (20) _____ Monday afternoon.","o":["at","on","in","from"],"a":1},{"q":"Everyone in the class (21) _____ to take part.","o":["want","wants","wanting","wanted"],"a":1},{"q":"What is the passage mainly about?","o":["Hoi An and its attractions","A modern shopping centre","A mountain village","A school trip"],"a":0},{"q":"What makes the town attractive at night?","o":["Colourful lanterns","Tall buildings","Bright traffic lights","Large stadiums"],"a":0},{"q":"What can tourists do on the river?","o":["Take a boat trip","Build houses","Plant rice","Drive a train"],"a":0},{"q":"The word “valued” is closest in meaning to ______.","o":["appreciated","forgotten","avoided","damaged"],"a":0},{"q":"Which statement is NOT TRUE?","o":["Hoi An is in central Viet Nam.","Visitors can taste local food.","The old town has narrow streets.","The town is known only for modern buildings."],"a":3},{"q":"Why is Hoi An important?","o":["For its beauty, history and culture","For its huge factories","For its snowy mountains","For its busy airports"],"a":0}],"reading":"Hoi An is a popular destination in central Viet Nam. Visitors enjoy walking through the old town, where many yellow houses and narrow streets remain. At night, colourful lanterns make the town especially attractive. Tourists can also taste local dishes and take a boat trip on the river. The town is valued not only for its beauty but also for its history and traditional culture.","written":{"word":[{"q":"We should protect rivers from ______. (POLLUTE)","a":"pollution"},{"q":"The documentary was very ______, so I watched it twice. (INTEREST)","a":"interesting"},{"q":"She sings very ______ in front of the audience. (BEAUTY)","a":"beautifully"},{"q":"The project was a great ______ for our school. (ACHIEVE)","a":"achievement"}],"rewrite":[{"q":"He started working here in 2023.","a":"He has worked here since 2023."},{"q":"Although the test was difficult, Mai finished it.","a":"The test was difficult, but Mai finished it."},{"q":"“I will help you tomorrow,” Nam said.","a":"Nam said that he would help me the next day."},{"q":"The book is interesting. I borrowed it from the library.","a":"The book which I borrowed from the library is interesting."}],"sentence":[{"q":"Next month / our class / organize / a clean-up day / at school","a":"Next month, our class will organize a clean-up day at school."},{"q":"My brother / be / interested in / learning / foreign languages","a":"My brother is interested in learning foreign languages."},{"q":"We / should / use / public transport / more often","a":"We should use public transport more often."},{"q":"The students / work / hard / to prepare / for the exam","a":"The students work hard to prepare for the exam."}]}},{"id":4,"title":"Đề 04 • Community Service","level":"medium","desc":"60 phút • 28 câu trắc nghiệm (7,0 điểm) + 12 câu tự luận (3,0 điểm)","questions":[{"q":"Please ______ the lights before leaving the room.","o":["turn off","turn on","look after","take after"],"a":0},{"q":"We should ______ plastic waste to protect the environment.","o":["increase","reduce","borrow","invite"],"a":1},{"q":"Although it was raining, they ______ playing football.","o":["continued","continue","continues","had continued"],"a":0},{"q":"She has lived here ______ 2022.","o":["for","since","during","from"],"a":1},{"q":"There isn’t ______ milk in the fridge.","o":["many","a few","much","several"],"a":2},{"q":"My father ______ to work by bus every day.","o":["go","goes","is going","went"],"a":1},{"q":"The movie was ______ that we watched it twice.","o":["so interesting","such interesting","too interest","interestingly"],"a":0},{"q":"I wish I ______ more time to read books.","o":["have","had","will have","am having"],"a":1},{"q":"They asked me where I ______ the book.","o":["buy","bought","will buy","am buying"],"a":1},{"q":"“Could you help me with this exercise?” “______”","o":["Sure. I’d be happy to.","Congratulations!","What a pity!","Good luck."],"a":0},{"q":"“I’m sorry I broke your pen.” “______”","o":["That’s all right.","Congratulations.","Here you are.","Good idea."],"a":0},{"q":"SWIMMING POOL: NO FOOD OR DRINKS.","o":["You must not eat or drink there.","You can have lunch there.","Drinks are free.","Food is required."],"a":0},{"q":"ENGLISH CLUB: EVERY FRIDAY, 4 P.M., ROOM 12.","o":["The club meets every Friday afternoon.","The club meets every Monday.","The club starts at noon.","The club is in Room 2."],"a":0},{"q":"a. First, prepare the ingredients. b. Finally, serve the dish. c. Then, cook them carefully.","o":["a-c-b","b-a-c","c-b-a","a-b-c"],"a":0},{"q":"a. I joined a reading club last month. b. It has helped me make new friends. c. We meet every Saturday morning.","o":["a-c-b","b-a-c","c-a-b","a-b-c"],"a":0},{"q":"He started learning English three years ago.","o":["He has learned English for three years.","He learns English three years ago.","He learned English since three years.","He has learning English three years."],"a":0},{"q":"“I will visit the museum tomorrow,” Minh said.","o":["Minh said that he would visit the museum the next day.","Minh said that I would visit the museum tomorrow.","Minh says he visited the museum.","Minh said he will visit the museum yesterday."],"a":0},{"q":"We should use public transport (19) _____ reduce air pollution.","o":["so that","because","although","but"],"a":0},{"q":"The meeting starts (20) _____ Monday afternoon.","o":["at","on","in","from"],"a":1},{"q":"Everyone in the class (21) _____ to take part.","o":["want","wants","wanting","wanted"],"a":1},{"q":"It is an (22) _____ way to learn together.","o":["enjoy","enjoyable","enjoyment","enjoyably"],"a":1},{"q":"Joining a sports club is a good way (18) _____ healthy.","o":["to stay","staying","stayed","stay"],"a":0},{"q":"What is the passage mainly about?","o":["A volunteer trip to a village","A school football match","A family holiday","A trip to a big city"],"a":0},{"q":"The word “worried” is closest in meaning to ______.","o":["happy","anxious","bored","excited"],"a":1},{"q":"What did the team do at the school?","o":["Painted the walls","Built a new classroom","Sold books","Taught mathematics"],"a":0},{"q":"Why did the writer become close to the team?","o":["They worked together.","They lived together for years.","They studied at the same school.","They played games all day."],"a":0},{"q":"Which statement is NOT TRUE?","o":["The trip lasted three days.","The children received books.","The writer returned home proud.","The team refused to help the school."],"a":3},{"q":"How did the writer feel at the end?","o":["Tired but proud","Angry and bored","Sad and lonely","Afraid and confused"],"a":0}],"reading":"Last summer, I joined a three-day volunteer trip to a small village. Our team painted the school walls, planted trees and gave books to children. At first, I was worried because I did not know anyone. However, after working together, we became close friends. The children were happy to receive the books and invited us to play football. I returned home tired but proud because I had done something useful.","written":{"word":[{"q":"The documentary was very ______, so I watched it twice. (INTEREST)","a":"interesting"},{"q":"She sings very ______ in front of the audience. (BEAUTY)","a":"beautifully"},{"q":"The project was a great ______ for our school. (ACHIEVE)","a":"achievement"},{"q":"Regular exercise is ______ for teenagers. (BENEFIT)","a":"beneficial"}],"rewrite":[{"q":"“I will help you tomorrow,” Nam said.","a":"Nam said that he would help me the next day."},{"q":"The book is interesting. I borrowed it from the library.","a":"The book which I borrowed from the library is interesting."},{"q":"You should save electricity or your bill will be high.","a":"If you do not save electricity, your bill will be high."},{"q":"They built this bridge last year.","a":"This bridge was built last year."}],"sentence":[{"q":"We / should / use / public transport / more often","a":"We should use public transport more often."},{"q":"The students / work / hard / to prepare / for the exam","a":"The students work hard to prepare for the exam."},{"q":"I / have / a plan / to visit / Da Lat / this summer","a":"I have a plan to visit Da Lat this summer."},{"q":"Our teacher / encourage / us / to read / English books","a":"Our teacher encourages us to read English books."}]}},{"id":5,"title":"Đề 05 • Technology","level":"medium","desc":"60 phút • 28 câu trắc nghiệm (7,0 điểm) + 12 câu tự luận (3,0 điểm)","questions":[{"q":"Although it was raining, they ______ playing football.","o":["continued","continue","continues","had continued"],"a":0},{"q":"She has lived here ______ 2022.","o":["for","since","during","from"],"a":1},{"q":"There isn’t ______ milk in the fridge.","o":["many","a few","much","several"],"a":2},{"q":"My father ______ to work by bus every day.","o":["go","goes","is going","went"],"a":1},{"q":"The movie was ______ that we watched it twice.","o":["so interesting","such interesting","too interest","interestingly"],"a":0},{"q":"I wish I ______ more time to read books.","o":["have","had","will have","am having"],"a":1},{"q":"They asked me where I ______ the book.","o":["buy","bought","will buy","am buying"],"a":1},{"q":"The road ______ last year is now much safer.","o":["repair","repaired","was repaired","repairing"],"a":1},{"q":"You should wear a helmet ______ you ride a motorbike.","o":["when","because","although","so"],"a":0},{"q":"“I’m sorry I broke your pen.” “______”","o":["That’s all right.","Congratulations.","Here you are.","Good idea."],"a":0},{"q":"“How often do you read English books?” “______”","o":["Twice a week.","At the library.","For two hours.","By bus."],"a":0},{"q":"ENGLISH CLUB: EVERY FRIDAY, 4 P.M., ROOM 12.","o":["The club meets every Friday afternoon.","The club meets every Monday.","The club starts at noon.","The club is in Room 2."],"a":0},{"q":"BIKE PARKING: USE THE AREA BEHIND THE SCHOOL.","o":["Students should park bikes behind the school.","Bikes must be parked in classrooms.","Cars are parked there.","The area is closed."],"a":0},{"q":"a. I joined a reading club last month. b. It has helped me make new friends. c. We meet every Saturday morning.","o":["a-c-b","b-a-c","c-a-b","a-b-c"],"a":0},{"q":"a. We collected old clothes. b. The storm damaged many houses. c. We gave the clothes to families in need.","o":["b-a-c","a-b-c","c-a-b","b-c-a"],"a":0},{"q":"“I will visit the museum tomorrow,” Minh said.","o":["Minh said that he would visit the museum the next day.","Minh said that I would visit the museum tomorrow.","Minh says he visited the museum.","Minh said he will visit the museum yesterday."],"a":0},{"q":"The girl is my cousin. She won the scholarship.","o":["The girl who won the scholarship is my cousin.","The girl which won the scholarship is my cousin.","The girl whom won the scholarship is my cousin.","The girl winning it are my cousin."],"a":0},{"q":"Everyone in the class (21) _____ to take part.","o":["want","wants","wanting","wanted"],"a":1},{"q":"It is an (22) _____ way to learn together.","o":["enjoy","enjoyable","enjoyment","enjoyably"],"a":1},{"q":"Joining a sports club is a good way (18) _____ healthy.","o":["to stay","staying","stayed","stay"],"a":0},{"q":"Our club meets twice a week, (19) _____ Tuesday and Thursday.","o":["but","and","or","so"],"a":1},{"q":"The activities begin (20) _____ 4 p.m.","o":["in","on","at","for"],"a":2},{"q":"What is the passage mainly about?","o":["Using smartphones wisely for study","Buying a new smartphone","Playing games online","Avoiding all technology"],"a":0},{"q":"The word “concentrate” is closest in meaning to ______.","o":["focus","sleep","travel","exercise"],"a":0},{"q":"What can teenagers do with smartphones?","o":["Watch lessons","Only make calls","Only play games","Only take photos"],"a":0},{"q":"What may happen if a phone is used too long?","o":["It may reduce exercise time.","It always improves grades.","It makes students stronger.","It replaces sleep with exercise."],"a":0},{"q":"Which is suggested as a solution?","o":["Set a screen-time limit.","Use the phone all day.","Avoid all breaks.","Stop studying online."],"a":0},{"q":"According to the passage, smartphones are ______.","o":["useful when used wisely","always harmful","never useful","only for entertainment"],"a":0}],"reading":"Many teenagers now use smartphones for studying. They can watch lessons, look up new words and join online classes. However, using a phone for too long may make it difficult to concentrate and can reduce time for exercise. A good solution is to set a daily screen-time limit and take regular breaks. Phones are useful learning tools when students use them wisely.","written":{"word":[{"q":"She sings very ______ in front of the audience. (BEAUTY)","a":"beautifully"},{"q":"The project was a great ______ for our school. (ACHIEVE)","a":"achievement"},{"q":"Regular exercise is ______ for teenagers. (BENEFIT)","a":"beneficial"},{"q":"The students worked ______ to finish the task. (CARE)","a":"carefully"}],"rewrite":[{"q":"You should save electricity or your bill will be high.","a":"If you do not save electricity, your bill will be high."},{"q":"They built this bridge last year.","a":"This bridge was built last year."},{"q":"We stayed at home because it was raining.","a":"Because it was raining, we stayed at home."},{"q":"I do not have enough money, so I cannot buy the laptop.","a":"I wish I had enough money to buy the laptop."}],"sentence":[{"q":"I / have / a plan / to visit / Da Lat / this summer","a":"I have a plan to visit Da Lat this summer."},{"q":"Our teacher / encourage / us / to read / English books","a":"Our teacher encourages us to read English books."},{"q":"Last summer / Mai / visit / her grandparents / in the Mekong Delta","a":"Last summer, Mai visited her grandparents in the Mekong Delta."},{"q":"Doing exercise / be / a good way / stay healthy","a":"Doing exercise is a good way to stay healthy."}]}},{"id":6,"title":"Đề 06 • Travel & Culture","level":"medium","desc":"60 phút • 28 câu trắc nghiệm (7,0 điểm) + 12 câu tự luận (3,0 điểm)","questions":[{"q":"There isn’t ______ milk in the fridge.","o":["many","a few","much","several"],"a":2},{"q":"My father ______ to work by bus every day.","o":["go","goes","is going","went"],"a":1},{"q":"The movie was ______ that we watched it twice.","o":["so interesting","such interesting","too interest","interestingly"],"a":0},{"q":"I wish I ______ more time to read books.","o":["have","had","will have","am having"],"a":1},{"q":"They asked me where I ______ the book.","o":["buy","bought","will buy","am buying"],"a":1},{"q":"The road ______ last year is now much safer.","o":["repair","repaired","was repaired","repairing"],"a":1},{"q":"You should wear a helmet ______ you ride a motorbike.","o":["when","because","although","so"],"a":0},{"q":"We need to leave early ______ we do not miss the train.","o":["because","so that","although","but"],"a":1},{"q":"The school library ______ many useful books for students.","o":["provides","providing","provide","provided"],"a":0},{"q":"“How often do you read English books?” “______”","o":["Twice a week.","At the library.","For two hours.","By bus."],"a":0},{"q":"Mai: “Would you like some orange juice?” Nam: “______”","o":["Yes, please.","Never mind.","That’s all right.","I’m sorry to hear that."],"a":0},{"q":"BIKE PARKING: USE THE AREA BEHIND THE SCHOOL.","o":["Students should park bikes behind the school.","Bikes must be parked in classrooms.","Cars are parked there.","The area is closed."],"a":0},{"q":"NOTICE: KEEP SILENCE IN THE LIBRARY.","o":["You must be quiet in the library.","You may sing in the library.","The library is closed.","Books are not allowed."],"a":0},{"q":"a. We collected old clothes. b. The storm damaged many houses. c. We gave the clothes to families in need.","o":["b-a-c","a-b-c","c-a-b","b-c-a"],"a":0},{"q":"a. I am writing to tell you about my trip. b. We visited several museums. c. It was an unforgettable experience.","o":["a-b-c","b-c-a","c-a-b","a-c-b"],"a":0},{"q":"The girl is my cousin. She won the scholarship.","o":["The girl who won the scholarship is my cousin.","The girl which won the scholarship is my cousin.","The girl whom won the scholarship is my cousin.","The girl winning it are my cousin."],"a":0},{"q":"The weather was bad, but we went hiking.","o":["Although the weather was bad, we went hiking.","Because the weather was bad, we went hiking.","So the weather was bad, we went hiking.","The weather was bad because we went hiking."],"a":0},{"q":"Joining a sports club is a good way (18) _____ healthy.","o":["to stay","staying","stayed","stay"],"a":0},{"q":"Our club meets twice a week, (19) _____ Tuesday and Thursday.","o":["but","and","or","so"],"a":1},{"q":"The activities begin (20) _____ 4 p.m.","o":["in","on","at","for"],"a":2},{"q":"All students (21) _____ welcome to join us.","o":["is","are","was","be"],"a":1},{"q":"Let’s stay (22) _____ and enjoy the activities!","o":["active","actively","activity","act"],"a":0},{"q":"What is the passage mainly about?","o":["Hoi An and its attractions","A modern shopping centre","A mountain village","A school trip"],"a":0},{"q":"What makes the town attractive at night?","o":["Colourful lanterns","Tall buildings","Bright traffic lights","Large stadiums"],"a":0},{"q":"What can tourists do on the river?","o":["Take a boat trip","Build houses","Plant rice","Drive a train"],"a":0},{"q":"The word “valued” is closest in meaning to ______.","o":["appreciated","forgotten","avoided","damaged"],"a":0},{"q":"Which statement is NOT TRUE?","o":["Hoi An is in central Viet Nam.","Visitors can taste local food.","The old town has narrow streets.","The town is known only for modern buildings."],"a":3},{"q":"Why is Hoi An important?","o":["For its beauty, history and culture","For its huge factories","For its snowy mountains","For its busy airports"],"a":0}],"reading":"Hoi An is a popular destination in central Viet Nam. Visitors enjoy walking through the old town, where many yellow houses and narrow streets remain. At night, colourful lanterns make the town especially attractive. Tourists can also taste local dishes and take a boat trip on the river. The town is valued not only for its beauty but also for its history and traditional culture.","written":{"word":[{"q":"The project was a great ______ for our school. (ACHIEVE)","a":"achievement"},{"q":"Regular exercise is ______ for teenagers. (BENEFIT)","a":"beneficial"},{"q":"The students worked ______ to finish the task. (CARE)","a":"carefully"},{"q":"The village has changed ______ in recent years. (CONSIDER)","a":"considerably"}],"rewrite":[{"q":"We stayed at home because it was raining.","a":"Because it was raining, we stayed at home."},{"q":"I do not have enough money, so I cannot buy the laptop.","a":"I wish I had enough money to buy the laptop."},{"q":"Study hard or you will fail the exam.","a":"If you do not study hard, you will fail the exam."},{"q":"“Where do you live?” she asked me.","a":"She asked me where I lived."}],"sentence":[{"q":"Last summer / Mai / visit / her grandparents / in the Mekong Delta","a":"Last summer, Mai visited her grandparents in the Mekong Delta."},{"q":"Doing exercise / be / a good way / stay healthy","a":"Doing exercise is a good way to stay healthy."},{"q":"I / want / join / the English club / because / I love speaking English","a":"I want to join the English club because I love speaking English."},{"q":"The woman / live / next door / often / help / local children","a":"The woman who lives next door often helps local children."}]}},{"id":7,"title":"Đề 07 • Future Careers","level":"medium","desc":"60 phút • 28 câu trắc nghiệm (7,0 điểm) + 12 câu tự luận (3,0 điểm)","questions":[{"q":"The movie was ______ that we watched it twice.","o":["so interesting","such interesting","too interest","interestingly"],"a":0},{"q":"I wish I ______ more time to read books.","o":["have","had","will have","am having"],"a":1},{"q":"They asked me where I ______ the book.","o":["buy","bought","will buy","am buying"],"a":1},{"q":"The road ______ last year is now much safer.","o":["repair","repaired","was repaired","repairing"],"a":1},{"q":"You should wear a helmet ______ you ride a motorbike.","o":["when","because","although","so"],"a":0},{"q":"We need to leave early ______ we do not miss the train.","o":["because","so that","although","but"],"a":1},{"q":"The school library ______ many useful books for students.","o":["provides","providing","provide","provided"],"a":0},{"q":"My sister usually goes to school ______ bicycle.","o":["in","by","on","at"],"a":1},{"q":"When I arrived, they ______ dinner.","o":["have","had","were having","are having"],"a":2},{"q":"Mai: “Would you like some orange juice?” Nam: “______”","o":["Yes, please.","Never mind.","That’s all right.","I’m sorry to hear that."],"a":0},{"q":"Lan: “Congratulations on your success!” Hoa: “______”","o":["You’re welcome.","Thanks a lot.","Not at all.","No, thanks."],"a":1},{"q":"NOTICE: KEEP SILENCE IN THE LIBRARY.","o":["You must be quiet in the library.","You may sing in the library.","The library is closed.","Books are not allowed."],"a":0},{"q":"BUS TO SCHOOL: First bus 6:30 a.m. Last bus 7:30 a.m.","o":["The first school bus leaves at 6:30.","The last bus leaves at 6:30.","Buses run all night.","Students must walk."],"a":0},{"q":"a. I am writing to tell you about my trip. b. We visited several museums. c. It was an unforgettable experience.","o":["a-b-c","b-c-a","c-a-b","a-c-b"],"a":0},{"q":"a. First, prepare the ingredients. b. Finally, serve the dish. c. Then, cook them carefully.","o":["a-c-b","b-a-c","c-b-a","a-b-c"],"a":0},{"q":"The weather was bad, but we went hiking.","o":["Although the weather was bad, we went hiking.","Because the weather was bad, we went hiking.","So the weather was bad, we went hiking.","The weather was bad because we went hiking."],"a":0},{"q":"He started learning English three years ago.","o":["He has learned English for three years.","He learns English three years ago.","He learned English since three years.","He has learning English three years."],"a":0},{"q":"The activities begin (20) _____ 4 p.m.","o":["in","on","at","for"],"a":2},{"q":"All students (21) _____ welcome to join us.","o":["is","are","was","be"],"a":1},{"q":"Let’s stay (22) _____ and enjoy the activities!","o":["active","actively","activity","act"],"a":0},{"q":"Reading every day can help students (18) _____ their vocabulary.","o":["improve","improving","improved","improves"],"a":0},{"q":"We should use public transport (19) _____ reduce air pollution.","o":["so that","because","although","but"],"a":0},{"q":"What is the passage mainly about?","o":["A volunteer trip to a village","A school football match","A family holiday","A trip to a big city"],"a":0},{"q":"The word “worried” is closest in meaning to ______.","o":["happy","anxious","bored","excited"],"a":1},{"q":"What did the team do at the school?","o":["Painted the walls","Built a new classroom","Sold books","Taught mathematics"],"a":0},{"q":"Why did the writer become close to the team?","o":["They worked together.","They lived together for years.","They studied at the same school.","They played games all day."],"a":0},{"q":"Which statement is NOT TRUE?","o":["The trip lasted three days.","The children received books.","The writer returned home proud.","The team refused to help the school."],"a":3},{"q":"How did the writer feel at the end?","o":["Tired but proud","Angry and bored","Sad and lonely","Afraid and confused"],"a":0}],"reading":"Last summer, I joined a three-day volunteer trip to a small village. Our team painted the school walls, planted trees and gave books to children. At first, I was worried because I did not know anyone. However, after working together, we became close friends. The children were happy to receive the books and invited us to play football. I returned home tired but proud because I had done something useful.","written":{"word":[{"q":"Regular exercise is ______ for teenagers. (BENEFIT)","a":"beneficial"},{"q":"The students worked ______ to finish the task. (CARE)","a":"carefully"},{"q":"The village has changed ______ in recent years. (CONSIDER)","a":"considerably"},{"q":"We need more ______ solutions to reduce waste. (CREATE)","a":"creative"}],"rewrite":[{"q":"Study hard or you will fail the exam.","a":"If you do not study hard, you will fail the exam."},{"q":"“Where do you live?” she asked me.","a":"She asked me where I lived."},{"q":"He started working here in 2023.","a":"He has worked here since 2023."},{"q":"Although the test was difficult, Mai finished it.","a":"The test was difficult, but Mai finished it."}],"sentence":[{"q":"I / want / join / the English club / because / I love speaking English","a":"I want to join the English club because I love speaking English."},{"q":"The woman / live / next door / often / help / local children","a":"The woman who lives next door often helps local children."},{"q":"Next month / our class / organize / a clean-up day / at school","a":"Next month, our class will organize a clean-up day at school."},{"q":"My brother / be / interested in / learning / foreign languages","a":"My brother is interested in learning foreign languages."}]}},{"id":8,"title":"Đề 08 • Festivals","level":"medium","desc":"60 phút • 28 câu trắc nghiệm (7,0 điểm) + 12 câu tự luận (3,0 điểm)","questions":[{"q":"They asked me where I ______ the book.","o":["buy","bought","will buy","am buying"],"a":1},{"q":"The road ______ last year is now much safer.","o":["repair","repaired","was repaired","repairing"],"a":1},{"q":"You should wear a helmet ______ you ride a motorbike.","o":["when","because","although","so"],"a":0},{"q":"We need to leave early ______ we do not miss the train.","o":["because","so that","although","but"],"a":1},{"q":"The school library ______ many useful books for students.","o":["provides","providing","provide","provided"],"a":0},{"q":"My sister usually goes to school ______ bicycle.","o":["in","by","on","at"],"a":1},{"q":"When I arrived, they ______ dinner.","o":["have","had","were having","are having"],"a":2},{"q":"This exercise is ______ than the previous one.","o":["easy","easier","easiest","as easy"],"a":1},{"q":"If you study hard, you ______ good results.","o":["get","got","will get","would get"],"a":2},{"q":"Lan: “Congratulations on your success!” Hoa: “______”","o":["You’re welcome.","Thanks a lot.","Not at all.","No, thanks."],"a":1},{"q":"“Why don’t we join the clean-up day?” “______”","o":["Good idea!","I don’t know you.","You’re welcome.","Never mind."],"a":0},{"q":"BUS TO SCHOOL: First bus 6:30 a.m. Last bus 7:30 a.m.","o":["The first school bus leaves at 6:30.","The last bus leaves at 6:30.","Buses run all night.","Students must walk."],"a":0},{"q":"WANTED: VOLUNTEERS TO PLANT TREES. MEET AT 7 A.M. SUNDAY.","o":["Volunteers will plant trees on Sunday morning.","The event is on Saturday night.","Only teachers can join.","Trees are not needed."],"a":0},{"q":"a. First, prepare the ingredients. b. Finally, serve the dish. c. Then, cook them carefully.","o":["a-c-b","b-a-c","c-b-a","a-b-c"],"a":0},{"q":"a. I joined a reading club last month. b. It has helped me make new friends. c. We meet every Saturday morning.","o":["a-c-b","b-a-c","c-a-b","a-b-c"],"a":0},{"q":"He started learning English three years ago.","o":["He has learned English for three years.","He learns English three years ago.","He learned English since three years.","He has learning English three years."],"a":0},{"q":"“I will visit the museum tomorrow,” Minh said.","o":["Minh said that he would visit the museum the next day.","Minh said that I would visit the museum tomorrow.","Minh says he visited the museum.","Minh said he will visit the museum yesterday."],"a":0},{"q":"Let’s stay (22) _____ and enjoy the activities!","o":["active","actively","activity","act"],"a":0},{"q":"Reading every day can help students (18) _____ their vocabulary.","o":["improve","improving","improved","improves"],"a":0},{"q":"We should use public transport (19) _____ reduce air pollution.","o":["so that","because","although","but"],"a":0},{"q":"The meeting starts (20) _____ Monday afternoon.","o":["at","on","in","from"],"a":1},{"q":"Everyone in the class (21) _____ to take part.","o":["want","wants","wanting","wanted"],"a":1},{"q":"What is the passage mainly about?","o":["Using smartphones wisely for study","Buying a new smartphone","Playing games online","Avoiding all technology"],"a":0},{"q":"The word “concentrate” is closest in meaning to ______.","o":["focus","sleep","travel","exercise"],"a":0},{"q":"What can teenagers do with smartphones?","o":["Watch lessons","Only make calls","Only play games","Only take photos"],"a":0},{"q":"What may happen if a phone is used too long?","o":["It may reduce exercise time.","It always improves grades.","It makes students stronger.","It replaces sleep with exercise."],"a":0},{"q":"Which is suggested as a solution?","o":["Set a screen-time limit.","Use the phone all day.","Avoid all breaks.","Stop studying online."],"a":0},{"q":"According to the passage, smartphones are ______.","o":["useful when used wisely","always harmful","never useful","only for entertainment"],"a":0}],"reading":"Many teenagers now use smartphones for studying. They can watch lessons, look up new words and join online classes. However, using a phone for too long may make it difficult to concentrate and can reduce time for exercise. A good solution is to set a daily screen-time limit and take regular breaks. Phones are useful learning tools when students use them wisely.","written":{"word":[{"q":"The students worked ______ to finish the task. (CARE)","a":"carefully"},{"q":"The village has changed ______ in recent years. (CONSIDER)","a":"considerably"},{"q":"We need more ______ solutions to reduce waste. (CREATE)","a":"creative"},{"q":"Linh answered the question ______ and everyone understood her. (CLEAR)","a":"clearly"}],"rewrite":[{"q":"He started working here in 2023.","a":"He has worked here since 2023."},{"q":"Although the test was difficult, Mai finished it.","a":"The test was difficult, but Mai finished it."},{"q":"“I will help you tomorrow,” Nam said.","a":"Nam said that he would help me the next day."},{"q":"The book is interesting. I borrowed it from the library.","a":"The book which I borrowed from the library is interesting."}],"sentence":[{"q":"Next month / our class / organize / a clean-up day / at school","a":"Next month, our class will organize a clean-up day at school."},{"q":"My brother / be / interested in / learning / foreign languages","a":"My brother is interested in learning foreign languages."},{"q":"We / should / use / public transport / more often","a":"We should use public transport more often."},{"q":"The students / work / hard / to prepare / for the exam","a":"The students work hard to prepare for the exam."}]}},{"id":9,"title":"Đề 09 • Natural Wonders","level":"medium","desc":"60 phút • 28 câu trắc nghiệm (7,0 điểm) + 12 câu tự luận (3,0 điểm)","questions":[{"q":"You should wear a helmet ______ you ride a motorbike.","o":["when","because","although","so"],"a":0},{"q":"We need to leave early ______ we do not miss the train.","o":["because","so that","although","but"],"a":1},{"q":"The school library ______ many useful books for students.","o":["provides","providing","provide","provided"],"a":0},{"q":"My sister usually goes to school ______ bicycle.","o":["in","by","on","at"],"a":1},{"q":"When I arrived, they ______ dinner.","o":["have","had","were having","are having"],"a":2},{"q":"This exercise is ______ than the previous one.","o":["easy","easier","easiest","as easy"],"a":1},{"q":"If you study hard, you ______ good results.","o":["get","got","will get","would get"],"a":2},{"q":"The student ______ won the prize is my best friend.","o":["which","whose","who","whom"],"a":2},{"q":"Please ______ the lights before leaving the room.","o":["turn off","turn on","look after","take after"],"a":0},{"q":"“Why don’t we join the clean-up day?” “______”","o":["Good idea!","I don’t know you.","You’re welcome.","Never mind."],"a":0},{"q":"“Could you help me with this exercise?” “______”","o":["Sure. I’d be happy to.","Congratulations!","What a pity!","Good luck."],"a":0},{"q":"WANTED: VOLUNTEERS TO PLANT TREES. MEET AT 7 A.M. SUNDAY.","o":["Volunteers will plant trees on Sunday morning.","The event is on Saturday night.","Only teachers can join.","Trees are not needed."],"a":0},{"q":"SWIMMING POOL: NO FOOD OR DRINKS.","o":["You must not eat or drink there.","You can have lunch there.","Drinks are free.","Food is required."],"a":0},{"q":"a. I joined a reading club last month. b. It has helped me make new friends. c. We meet every Saturday morning.","o":["a-c-b","b-a-c","c-a-b","a-b-c"],"a":0},{"q":"a. We collected old clothes. b. The storm damaged many houses. c. We gave the clothes to families in need.","o":["b-a-c","a-b-c","c-a-b","b-c-a"],"a":0},{"q":"“I will visit the museum tomorrow,” Minh said.","o":["Minh said that he would visit the museum the next day.","Minh said that I would visit the museum tomorrow.","Minh says he visited the museum.","Minh said he will visit the museum yesterday."],"a":0},{"q":"The girl is my cousin. She won the scholarship.","o":["The girl who won the scholarship is my cousin.","The girl which won the scholarship is my cousin.","The girl whom won the scholarship is my cousin.","The girl winning it are my cousin."],"a":0},{"q":"We should use public transport (19) _____ reduce air pollution.","o":["so that","because","although","but"],"a":0},{"q":"The meeting starts (20) _____ Monday afternoon.","o":["at","on","in","from"],"a":1},{"q":"Everyone in the class (21) _____ to take part.","o":["want","wants","wanting","wanted"],"a":1},{"q":"It is an (22) _____ way to learn together.","o":["enjoy","enjoyable","enjoyment","enjoyably"],"a":1},{"q":"Joining a sports club is a good way (18) _____ healthy.","o":["to stay","staying","stayed","stay"],"a":0},{"q":"What is the passage mainly about?","o":["Hoi An and its attractions","A modern shopping centre","A mountain village","A school trip"],"a":0},{"q":"What makes the town attractive at night?","o":["Colourful lanterns","Tall buildings","Bright traffic lights","Large stadiums"],"a":0},{"q":"What can tourists do on the river?","o":["Take a boat trip","Build houses","Plant rice","Drive a train"],"a":0},{"q":"The word “valued” is closest in meaning to ______.","o":["appreciated","forgotten","avoided","damaged"],"a":0},{"q":"Which statement is NOT TRUE?","o":["Hoi An is in central Viet Nam.","Visitors can taste local food.","The old town has narrow streets.","The town is known only for modern buildings."],"a":3},{"q":"Why is Hoi An important?","o":["For its beauty, history and culture","For its huge factories","For its snowy mountains","For its busy airports"],"a":0}],"reading":"Hoi An is a popular destination in central Viet Nam. Visitors enjoy walking through the old town, where many yellow houses and narrow streets remain. At night, colourful lanterns make the town especially attractive. Tourists can also taste local dishes and take a boat trip on the river. The town is valued not only for its beauty but also for its history and traditional culture.","written":{"word":[{"q":"The village has changed ______ in recent years. (CONSIDER)","a":"considerably"},{"q":"We need more ______ solutions to reduce waste. (CREATE)","a":"creative"},{"q":"Linh answered the question ______ and everyone understood her. (CLEAR)","a":"clearly"},{"q":"Tourism contributes to the ______ of many local communities. (DEVELOP)","a":"development"}],"rewrite":[{"q":"“I will help you tomorrow,” Nam said.","a":"Nam said that he would help me the next day."},{"q":"The book is interesting. I borrowed it from the library.","a":"The book which I borrowed from the library is interesting."},{"q":"You should save electricity or your bill will be high.","a":"If you do not save electricity, your bill will be high."},{"q":"They built this bridge last year.","a":"This bridge was built last year."}],"sentence":[{"q":"We / should / use / public transport / more often","a":"We should use public transport more often."},{"q":"The students / work / hard / to prepare / for the exam","a":"The students work hard to prepare for the exam."},{"q":"I / have / a plan / to visit / Da Lat / this summer","a":"I have a plan to visit Da Lat this summer."},{"q":"Our teacher / encourage / us / to read / English books","a":"Our teacher encourages us to read English books."}]}},{"id":10,"title":"Đề 10 • Education","level":"exam","desc":"60 phút • 28 câu trắc nghiệm (7,0 điểm) + 12 câu tự luận (3,0 điểm)","questions":[{"q":"The school library ______ many useful books for students.","o":["provides","providing","provide","provided"],"a":0},{"q":"My sister usually goes to school ______ bicycle.","o":["in","by","on","at"],"a":1},{"q":"When I arrived, they ______ dinner.","o":["have","had","were having","are having"],"a":2},{"q":"This exercise is ______ than the previous one.","o":["easy","easier","easiest","as easy"],"a":1},{"q":"If you study hard, you ______ good results.","o":["get","got","will get","would get"],"a":2},{"q":"The student ______ won the prize is my best friend.","o":["which","whose","who","whom"],"a":2},{"q":"Please ______ the lights before leaving the room.","o":["turn off","turn on","look after","take after"],"a":0},{"q":"We should ______ plastic waste to protect the environment.","o":["increase","reduce","borrow","invite"],"a":1},{"q":"Although it was raining, they ______ playing football.","o":["continued","continue","continues","had continued"],"a":0},{"q":"“Could you help me with this exercise?” “______”","o":["Sure. I’d be happy to.","Congratulations!","What a pity!","Good luck."],"a":0},{"q":"“I’m sorry I broke your pen.” “______”","o":["That’s all right.","Congratulations.","Here you are.","Good idea."],"a":0},{"q":"SWIMMING POOL: NO FOOD OR DRINKS.","o":["You must not eat or drink there.","You can have lunch there.","Drinks are free.","Food is required."],"a":0},{"q":"ENGLISH CLUB: EVERY FRIDAY, 4 P.M., ROOM 12.","o":["The club meets every Friday afternoon.","The club meets every Monday.","The club starts at noon.","The club is in Room 2."],"a":0},{"q":"a. We collected old clothes. b. The storm damaged many houses. c. We gave the clothes to families in need.","o":["b-a-c","a-b-c","c-a-b","b-c-a"],"a":0},{"q":"a. I am writing to tell you about my trip. b. We visited several museums. c. It was an unforgettable experience.","o":["a-b-c","b-c-a","c-a-b","a-c-b"],"a":0},{"q":"The girl is my cousin. She won the scholarship.","o":["The girl who won the scholarship is my cousin.","The girl which won the scholarship is my cousin.","The girl whom won the scholarship is my cousin.","The girl winning it are my cousin."],"a":0},{"q":"The weather was bad, but we went hiking.","o":["Although the weather was bad, we went hiking.","Because the weather was bad, we went hiking.","So the weather was bad, we went hiking.","The weather was bad because we went hiking."],"a":0},{"q":"Everyone in the class (21) _____ to take part.","o":["want","wants","wanting","wanted"],"a":1},{"q":"It is an (22) _____ way to learn together.","o":["enjoy","enjoyable","enjoyment","enjoyably"],"a":1},{"q":"Joining a sports club is a good way (18) _____ healthy.","o":["to stay","staying","stayed","stay"],"a":0},{"q":"Our club meets twice a week, (19) _____ Tuesday and Thursday.","o":["but","and","or","so"],"a":1},{"q":"The activities begin (20) _____ 4 p.m.","o":["in","on","at","for"],"a":2},{"q":"What is the passage mainly about?","o":["A volunteer trip to a village","A school football match","A family holiday","A trip to a big city"],"a":0},{"q":"The word “worried” is closest in meaning to ______.","o":["happy","anxious","bored","excited"],"a":1},{"q":"What did the team do at the school?","o":["Painted the walls","Built a new classroom","Sold books","Taught mathematics"],"a":0},{"q":"Why did the writer become close to the team?","o":["They worked together.","They lived together for years.","They studied at the same school.","They played games all day."],"a":0},{"q":"Which statement is NOT TRUE?","o":["The trip lasted three days.","The children received books.","The writer returned home proud.","The team refused to help the school."],"a":3},{"q":"How did the writer feel at the end?","o":["Tired but proud","Angry and bored","Sad and lonely","Afraid and confused"],"a":0}],"reading":"Last summer, I joined a three-day volunteer trip to a small village. Our team painted the school walls, planted trees and gave books to children. At first, I was worried because I did not know anyone. However, after working together, we became close friends. The children were happy to receive the books and invited us to play football. I returned home tired but proud because I had done something useful.","written":{"word":[{"q":"We need more ______ solutions to reduce waste. (CREATE)","a":"creative"},{"q":"Linh answered the question ______ and everyone understood her. (CLEAR)","a":"clearly"},{"q":"Tourism contributes to the ______ of many local communities. (DEVELOP)","a":"development"},{"q":"We should protect rivers from ______. (POLLUTE)","a":"pollution"}],"rewrite":[{"q":"You should save electricity or your bill will be high.","a":"If you do not save electricity, your bill will be high."},{"q":"They built this bridge last year.","a":"This bridge was built last year."},{"q":"We stayed at home because it was raining.","a":"Because it was raining, we stayed at home."},{"q":"I do not have enough money, so I cannot buy the laptop.","a":"I wish I had enough money to buy the laptop."}],"sentence":[{"q":"I / have / a plan / to visit / Da Lat / this summer","a":"I have a plan to visit Da Lat this summer."},{"q":"Our teacher / encourage / us / to read / English books","a":"Our teacher encourages us to read English books."},{"q":"Last summer / Mai / visit / her grandparents / in the Mekong Delta","a":"Last summer, Mai visited her grandparents in the Mekong Delta."},{"q":"Doing exercise / be / a good way / stay healthy","a":"Doing exercise is a good way to stay healthy."}]}},{"id":11,"title":"Đề 11 • Teen Life","level":"exam","desc":"60 phút • 28 câu trắc nghiệm (7,0 điểm) + 12 câu tự luận (3,0 điểm)","questions":[{"q":"When I arrived, they ______ dinner.","o":["have","had","were having","are having"],"a":2},{"q":"This exercise is ______ than the previous one.","o":["easy","easier","easiest","as easy"],"a":1},{"q":"If you study hard, you ______ good results.","o":["get","got","will get","would get"],"a":2},{"q":"The student ______ won the prize is my best friend.","o":["which","whose","who","whom"],"a":2},{"q":"Please ______ the lights before leaving the room.","o":["turn off","turn on","look after","take after"],"a":0},{"q":"We should ______ plastic waste to protect the environment.","o":["increase","reduce","borrow","invite"],"a":1},{"q":"Although it was raining, they ______ playing football.","o":["continued","continue","continues","had continued"],"a":0},{"q":"She has lived here ______ 2022.","o":["for","since","during","from"],"a":1},{"q":"There isn’t ______ milk in the fridge.","o":["many","a few","much","several"],"a":2},{"q":"“I’m sorry I broke your pen.” “______”","o":["That’s all right.","Congratulations.","Here you are.","Good idea."],"a":0},{"q":"“How often do you read English books?” “______”","o":["Twice a week.","At the library.","For two hours.","By bus."],"a":0},{"q":"ENGLISH CLUB: EVERY FRIDAY, 4 P.M., ROOM 12.","o":["The club meets every Friday afternoon.","The club meets every Monday.","The club starts at noon.","The club is in Room 2."],"a":0},{"q":"BIKE PARKING: USE THE AREA BEHIND THE SCHOOL.","o":["Students should park bikes behind the school.","Bikes must be parked in classrooms.","Cars are parked there.","The area is closed."],"a":0},{"q":"a. I am writing to tell you about my trip. b. We visited several museums. c. It was an unforgettable experience.","o":["a-b-c","b-c-a","c-a-b","a-c-b"],"a":0},{"q":"a. First, prepare the ingredients. b. Finally, serve the dish. c. Then, cook them carefully.","o":["a-c-b","b-a-c","c-b-a","a-b-c"],"a":0},{"q":"The weather was bad, but we went hiking.","o":["Although the weather was bad, we went hiking.","Because the weather was bad, we went hiking.","So the weather was bad, we went hiking.","The weather was bad because we went hiking."],"a":0},{"q":"He started learning English three years ago.","o":["He has learned English for three years.","He learns English three years ago.","He learned English since three years.","He has learning English three years."],"a":0},{"q":"Joining a sports club is a good way (18) _____ healthy.","o":["to stay","staying","stayed","stay"],"a":0},{"q":"Our club meets twice a week, (19) _____ Tuesday and Thursday.","o":["but","and","or","so"],"a":1},{"q":"The activities begin (20) _____ 4 p.m.","o":["in","on","at","for"],"a":2},{"q":"All students (21) _____ welcome to join us.","o":["is","are","was","be"],"a":1},{"q":"Let’s stay (22) _____ and enjoy the activities!","o":["active","actively","activity","act"],"a":0},{"q":"What is the passage mainly about?","o":["Using smartphones wisely for study","Buying a new smartphone","Playing games online","Avoiding all technology"],"a":0},{"q":"The word “concentrate” is closest in meaning to ______.","o":["focus","sleep","travel","exercise"],"a":0},{"q":"What can teenagers do with smartphones?","o":["Watch lessons","Only make calls","Only play games","Only take photos"],"a":0},{"q":"What may happen if a phone is used too long?","o":["It may reduce exercise time.","It always improves grades.","It makes students stronger.","It replaces sleep with exercise."],"a":0},{"q":"Which is suggested as a solution?","o":["Set a screen-time limit.","Use the phone all day.","Avoid all breaks.","Stop studying online."],"a":0},{"q":"According to the passage, smartphones are ______.","o":["useful when used wisely","always harmful","never useful","only for entertainment"],"a":0}],"reading":"Many teenagers now use smartphones for studying. They can watch lessons, look up new words and join online classes. However, using a phone for too long may make it difficult to concentrate and can reduce time for exercise. A good solution is to set a daily screen-time limit and take regular breaks. Phones are useful learning tools when students use them wisely.","written":{"word":[{"q":"Linh answered the question ______ and everyone understood her. (CLEAR)","a":"clearly"},{"q":"Tourism contributes to the ______ of many local communities. (DEVELOP)","a":"development"},{"q":"We should protect rivers from ______. (POLLUTE)","a":"pollution"},{"q":"The documentary was very ______, so I watched it twice. (INTEREST)","a":"interesting"}],"rewrite":[{"q":"We stayed at home because it was raining.","a":"Because it was raining, we stayed at home."},{"q":"I do not have enough money, so I cannot buy the laptop.","a":"I wish I had enough money to buy the laptop."},{"q":"Study hard or you will fail the exam.","a":"If you do not study hard, you will fail the exam."},{"q":"“Where do you live?” she asked me.","a":"She asked me where I lived."}],"sentence":[{"q":"Last summer / Mai / visit / her grandparents / in the Mekong Delta","a":"Last summer, Mai visited her grandparents in the Mekong Delta."},{"q":"Doing exercise / be / a good way / stay healthy","a":"Doing exercise is a good way to stay healthy."},{"q":"I / want / join / the English club / because / I love speaking English","a":"I want to join the English club because I love speaking English."},{"q":"The woman / live / next door / often / help / local children","a":"The woman who lives next door often helps local children."}]}},{"id":12,"title":"Đề 12 • Mixed Mock Test","level":"exam","desc":"60 phút • 28 câu trắc nghiệm (7,0 điểm) + 12 câu tự luận (3,0 điểm)","questions":[{"q":"If you study hard, you ______ good results.","o":["get","got","will get","would get"],"a":2},{"q":"The student ______ won the prize is my best friend.","o":["which","whose","who","whom"],"a":2},{"q":"Please ______ the lights before leaving the room.","o":["turn off","turn on","look after","take after"],"a":0},{"q":"We should ______ plastic waste to protect the environment.","o":["increase","reduce","borrow","invite"],"a":1},{"q":"Although it was raining, they ______ playing football.","o":["continued","continue","continues","had continued"],"a":0},{"q":"She has lived here ______ 2022.","o":["for","since","during","from"],"a":1},{"q":"There isn’t ______ milk in the fridge.","o":["many","a few","much","several"],"a":2},{"q":"My father ______ to work by bus every day.","o":["go","goes","is going","went"],"a":1},{"q":"The movie was ______ that we watched it twice.","o":["so interesting","such interesting","too interest","interestingly"],"a":0},{"q":"“How often do you read English books?” “______”","o":["Twice a week.","At the library.","For two hours.","By bus."],"a":0},{"q":"Mai: “Would you like some orange juice?” Nam: “______”","o":["Yes, please.","Never mind.","That’s all right.","I’m sorry to hear that."],"a":0},{"q":"BIKE PARKING: USE THE AREA BEHIND THE SCHOOL.","o":["Students should park bikes behind the school.","Bikes must be parked in classrooms.","Cars are parked there.","The area is closed."],"a":0},{"q":"NOTICE: KEEP SILENCE IN THE LIBRARY.","o":["You must be quiet in the library.","You may sing in the library.","The library is closed.","Books are not allowed."],"a":0},{"q":"a. First, prepare the ingredients. b. Finally, serve the dish. c. Then, cook them carefully.","o":["a-c-b","b-a-c","c-b-a","a-b-c"],"a":0},{"q":"a. I joined a reading club last month. b. It has helped me make new friends. c. We meet every Saturday morning.","o":["a-c-b","b-a-c","c-a-b","a-b-c"],"a":0},{"q":"He started learning English three years ago.","o":["He has learned English for three years.","He learns English three years ago.","He learned English since three years.","He has learning English three years."],"a":0},{"q":"“I will visit the museum tomorrow,” Minh said.","o":["Minh said that he would visit the museum the next day.","Minh said that I would visit the museum tomorrow.","Minh says he visited the museum.","Minh said he will visit the museum yesterday."],"a":0},{"q":"The activities begin (20) _____ 4 p.m.","o":["in","on","at","for"],"a":2},{"q":"All students (21) _____ welcome to join us.","o":["is","are","was","be"],"a":1},{"q":"Let’s stay (22) _____ and enjoy the activities!","o":["active","actively","activity","act"],"a":0},{"q":"Reading every day can help students (18) _____ their vocabulary.","o":["improve","improving","improved","improves"],"a":0},{"q":"We should use public transport (19) _____ reduce air pollution.","o":["so that","because","although","but"],"a":0},{"q":"What is the passage mainly about?","o":["Hoi An and its attractions","A modern shopping centre","A mountain village","A school trip"],"a":0},{"q":"What makes the town attractive at night?","o":["Colourful lanterns","Tall buildings","Bright traffic lights","Large stadiums"],"a":0},{"q":"What can tourists do on the river?","o":["Take a boat trip","Build houses","Plant rice","Drive a train"],"a":0},{"q":"The word “valued” is closest in meaning to ______.","o":["appreciated","forgotten","avoided","damaged"],"a":0},{"q":"Which statement is NOT TRUE?","o":["Hoi An is in central Viet Nam.","Visitors can taste local food.","The old town has narrow streets.","The town is known only for modern buildings."],"a":3},{"q":"Why is Hoi An important?","o":["For its beauty, history and culture","For its huge factories","For its snowy mountains","For its busy airports"],"a":0}],"reading":"Hoi An is a popular destination in central Viet Nam. Visitors enjoy walking through the old town, where many yellow houses and narrow streets remain. At night, colourful lanterns make the town especially attractive. Tourists can also taste local dishes and take a boat trip on the river. The town is valued not only for its beauty but also for its history and traditional culture.","written":{"word":[{"q":"Tourism contributes to the ______ of many local communities. (DEVELOP)","a":"development"},{"q":"We should protect rivers from ______. (POLLUTE)","a":"pollution"},{"q":"The documentary was very ______, so I watched it twice. (INTEREST)","a":"interesting"},{"q":"She sings very ______ in front of the audience. (BEAUTY)","a":"beautifully"}],"rewrite":[{"q":"Study hard or you will fail the exam.","a":"If you do not study hard, you will fail the exam."},{"q":"“Where do you live?” she asked me.","a":"She asked me where I lived."},{"q":"He started working here in 2023.","a":"He has worked here since 2023."},{"q":"Although the test was difficult, Mai finished it.","a":"The test was difficult, but Mai finished it."}],"sentence":[{"q":"I / want / join / the English club / because / I love speaking English","a":"I want to join the English club because I love speaking English."},{"q":"The woman / live / next door / often / help / local children","a":"The woman who lives next door often helps local children."},{"q":"Next month / our class / organize / a clean-up day / at school","a":"Next month, our class will organize a clean-up day at school."},{"q":"My brother / be / interested in / learning / foreign languages","a":"My brother is interested in learning foreign languages."}]}}];
let student={},subject='math',current=null,remain=0,timer=null,lastResult=null;
function saveStudent(){student={name:document.getElementById('name').value.trim(),sbd:document.getElementById('sbd').value.trim(),dob:document.getElementById('dob').value,gender:document.getElementById('gender').value,school:document.getElementById('school').value.trim(),className:document.getElementById('className').value.trim()};localStorage.setItem('t10student',JSON.stringify(student));}
function loadStudent(){try{student=JSON.parse(localStorage.getItem('t10student')||'{}')}catch(e){student={}};if(student.name){for(const k of ['name','sbd','dob','school','className'])if(student[k]!=null&&document.getElementById(k))document.getElementById(k).value=student[k];if(student.gender)document.getElementById('gender').value=student.gender}}
function enterSystem(){if(!document.getElementById('name').value.trim()||!document.getElementById('sbd').value.trim()){alert('Vui lòng nhập Họ và tên và Số báo danh.');return}saveStudent();showDashboard();}
function loginAndOpen(s){if(!document.getElementById('name').value.trim()||!document.getElementById('sbd').value.trim()){alert('Vui lòng nhập Họ và tên và Số báo danh trước.');return}saveStudent();openSubject(s)}
function hideAll(){['login','dashboard','library','exam','result'].forEach(id=>document.getElementById(id).classList.add('hidden'))}
function showDashboard(){clearInterval(timer);hideAll();document.getElementById('dashboard').classList.remove('hidden');document.getElementById('userpill').textContent=(student.name||'Thí sinh')+' • SBD '+(student.sbd||'');document.getElementById('info').innerHTML='<p><b>Họ và tên:</b> '+esc(student.name)+'</p><p><b>SBD:</b> '+esc(student.sbd)+'</p><p><b>Ngày sinh:</b> '+esc(student.dob||'Chưa nhập')+'</p><p><b>Giới tính:</b> '+esc(student.gender||'')+'</p><p><b>Trường:</b> '+esc(student.school||'Chưa nhập')+'</p><p><b>Lớp:</b> '+esc(student.className||'Chưa nhập')+'</p>';renderRank()}
function openSubject(s){subject=s;hideAll();document.getElementById('library').classList.remove('hidden');document.getElementById('libraryTitle').textContent=s==='math'?'KHO 12 ĐỀ TOÁN TUYỂN SINH 10':'KHO 12 ĐỀ TIẾNG ANH TUYỂN SINH 10';let data=s==='math'?mathExams:englishExams;document.getElementById('examGrid').innerHTML=data.map((e,i)=>`<div class="subjectcard"><h3>${esc(e.title)}</h3><p>${esc(e.desc||'')}</p><div class="meta"><span class="pill">Đề ${i+1}</span><span class="pill">${s==='math'?'90 phút':'60 phút'}</span></div><button class="btn" onclick="startExam(${e.id})">Làm đề →</button></div>`).join('')}
function showLibrary(){clearInterval(timer);openSubject(subject)}
function startExam(id){current=(subject==='math'?mathExams:englishExams).find(e=>e.id===id);hideAll();document.getElementById('exam').classList.remove('hidden');document.getElementById('examname').textContent=current.title+' • '+(subject==='math'?'Toán':'Tiếng Anh')+' tuyển sinh 10';renderQuestions();remain=subject==='math'?5400:3600;clearInterval(timer);tick();timer=setInterval(tick,1000);scrollTo(0,0)}
function tick(){let m=Math.floor(remain/60),s=remain%60;document.getElementById('clock').textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');if(remain<=300)document.getElementById('clock').classList.add('warn');if(remain<=0){clearInterval(timer);submitExam(true);return}remain--}
function renderQuestions(){let h='';if(subject==='math'){current.questions.forEach((q,i)=>{h+=`<div class="q"><h3>Câu ${i+1}. ${esc(q.q)}</h3>`;q.o.forEach((o,j)=>h+=`<label class="opt"><input type="radio" name="m${i}" value="${j}"> ${String.fromCharCode(65+j)}. ${esc(o)}</label>`);h+='</div>'});current.tf.forEach((q,i)=>{h+=`<div class="q"><h3>Đúng/Sai ${i+1}. ${esc(q.q)}</h3>`;q.items.forEach((o,j)=>h+=`<label class="opt"><input type="radio" name="tf${i}_${j}" value="1"> Đúng &nbsp; <input type="radio" name="tf${i}_${j}" value="0"> Sai — ${esc(o)}</label>`);h+='</div>'});current.short.forEach((q,i)=>h+=`<div class="q"><h3>Trả lời ngắn ${i+1}. ${esc(q.q)}</h3><input class="answer" id="s${i}" placeholder="Nhập đáp án"></div>`)}else{current.questions.forEach((q,i)=>{h+=`<div class="q"><h3>Câu ${i+1}. ${esc(q.q)}</h3>`;q.o.forEach((o,j)=>h+=`<label class="opt"><input type="radio" name="m${i}" value="${j}"> ${String.fromCharCode(65+j)}. ${esc(o)}</label>`);h+='</div>'});const w=current.written||{};h+='<div class="writtenbox"><h3>PHẦN TỰ LUẬN</h3>';(w.word||[]).forEach((q,i)=>h+=`<div class="q"><b>Word form ${i+1}:</b> ${esc(q.q)}<input class="answer" id="w${i}" placeholder="Nhập đáp án"></div>`);(w.rewrite||[]).forEach((q,i)=>h+=`<div class="q"><b>Rewrite ${i+1}:</b> ${esc(q.q)}<input class="answer" id="r${i}" placeholder="Viết lại câu"></div>`);(w.sentence||[]).forEach((q,i)=>h+=`<div class="q"><b>Sentence ${i+1}:</b> ${esc(q.q)}<input class="answer" id="s${i}" placeholder="Viết câu hoàn chỉnh"></div>`);h+='</div>'}document.getElementById('questions').innerHTML=h}
function norm(x){return String(x??'').trim().toLowerCase().replace(/[“”"'.,!?;:]/g,'').replace(/\s+/g,' ')}
function numNorm(x){return String(x??'').trim().toLowerCase().replace(',','.').replace(/\s/g,'')}
function similarity(u,a){u=norm(u);a=norm(a);if(!u)return false;if(u===a)return true;return a.split(' ').every(w=>u.includes(w))&&u.length>=Math.max(8,a.length*.75)}
function submitExam(auto){if(!auto&&!confirm('Bạn chắc chắn muốn nộp bài?'))return;clearInterval(timer);let score=0,detail='';if(subject==='math'){let mc=0,tf=0,sh=0;current.questions.forEach((q,i)=>{let v=document.querySelector(`input[name=m${i}]:checked`);if(v&&+v.value===q.a){score+=.25;mc++}});current.tf.forEach((q,i)=>q.a.forEach((a,j)=>{let v=document.querySelector(`input[name=tf${i}_${j}]:checked`);if(v&&+v.value===a){score+=.25;tf++}}));current.short.forEach((q,i)=>{if(numNorm(document.getElementById('s'+i).value)===numNorm(q.a)){score+=1;sh++}});detail=`Trắc nghiệm ${mc}/20 • Đúng/Sai ${tf}/8 ý • Trả lời ngắn ${sh}/3`}else{let mc=0,word=0,rewrite=0,sent=0;current.questions.forEach((q,i)=>{let v=document.querySelector(`input[name=m${i}]:checked`);if(v&&+v.value===q.a)mc++});(current.written.word||[]).forEach((q,i)=>{if(similarity(document.getElementById('w'+i).value,q.a))word++});(current.written.rewrite||[]).forEach((q,i)=>{if(similarity(document.getElementById('r'+i).value,q.a))rewrite++});(current.written.sentence||[]).forEach((q,i)=>{if(similarity(document.getElementById('s'+i).value,q.a))sent++});score=mc*(7/28)+(word+rewrite+sent)*.25;detail=`Trắc nghiệm ${mc}/28 • Word form ${word}/4 • Rewrite ${rewrite}/4 • Sentence ${sent}/4`}score=Math.round(score*100)/100;let used=(subject==='math'?5400:3600)-Math.max(remain,0);lastResult={name:student.name||'Thí sinh',sbd:student.sbd||'',subject:subject==='math'?'Toán':'Tiếng Anh',exam:current.title,score,time:used};let arr=JSON.parse(localStorage.getItem('t10rankAll')||'[]');arr.push(lastResult);arr.sort((a,b)=>b.score-a.score||a.time-b.time);localStorage.setItem('t10rankAll',JSON.stringify(arr.slice(0,100)));hideAll();document.getElementById('result').classList.remove('hidden');document.getElementById('score').textContent=score.toFixed(2)+'/10';document.getElementById('summary').innerHTML='<b>'+esc(current.title)+'</b><br>'+detail+(auto?'<br><b>Hết giờ — hệ thống tự nộp.</b>':'')}
function renderRank(){let a=JSON.parse(localStorage.getItem('t10rankAll')||'[]');document.getElementById('rankbox').innerHTML=a.length?`<table><tr><th>Hạng</th><th>Thí sinh</th><th>Môn</th><th>Đề</th><th>Điểm</th><th>Thời gian</th></tr>${a.map((x,i)=>`<tr><td>${i+1}</td><td>${esc(x.name)}<br><small>${esc(x.sbd)}</small></td><td>${x.subject}</td><td>${esc(x.exam)}</td><td><b>${Number(x.score).toFixed(2)}</b></td><td>${Math.floor(x.time/60)}p ${x.time%60}s</td></tr>`).join('')}</table>`:'Chưa có kết quả. Hãy làm bài để xuất hiện trên bảng xếp hạng.'}
function esc(x){return String(x??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
loadStudent();
</script></body></html>
